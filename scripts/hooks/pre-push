#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
# ⛔ PRE-PUSH — THE VERIFY GATE.  ⟦NEW 06/09 · הכרעה 100 · הוראה מפורשת של רוי⟧
#
# WHY THIS FILE EXISTS, precisely. Until today `npm run verify` was a SENTENCE in
# four prompt files. A sentence is not a gate: an agent that skipped it, or that
# ran it and misread the exit code, pushed exactly as easily as one that did not —
# and the branch only learned about it at the next QA tick, up to 12 hours later.
# ⇒ this hook makes the sentence mechanical. A red `verify` ⛔ cannot leave a clone.
#
# ⚠️ IT VERIFIES THE WORKING TREE, ⛔ NOT THE COMMIT RANGE — and that is deliberate,
# ⛔ not a shortcut: every agent in this loop commits and pushes in the same tick, so
# the tree at push time IS the tip being pushed. `git status --porcelain` is printed
# whenever it is NOT, so the gap is visible instead of assumed.
#
# ⇒ ON SUCCESS it records a `verify` git-note on every pushed tip and pushes the
#   notes ref. That note is what `loop:health` check 16 measures — an attestation
#   ⛔ no agent has to remember to write, and one that ⛔ cannot be back-dated.
#
# ESCAPE HATCH: `SKIP_VERIFY=1 ./scripts/g push …` — loud, printed, and ⛔ never the
# routine. It exists so a broken `verify` can never make the repo unpushable.
# ═══════════════════════════════════════════════════════════════════════════════
set -uo pipefail

# ⛔ The notes push below re-enters this hook. Without this guard it recurses.
if [ "${VERIFY_HOOK_INTERNAL:-0}" = "1" ]; then exit 0; fi

REMOTE="${1:-origin}"
ZERO=0000000000000000000000000000000000000000

TIPS=()
REFS=()
while read -r _localref localsha remoteref _remotesha; do
  [ -z "${localsha:-}" ] && continue
  [ "$localsha" = "$ZERO" ] && continue   # ⛔ a branch deletion carries no tree to verify
  TIPS+=("$localsha")
  REFS+=("${remoteref:-}")
done
if [ "${#TIPS[@]}" -eq 0 ]; then exit 0; fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# ═══════════════════════════════════════════════════════════════════════════════
# ⛔ BRANCH OWNERSHIP — ⛔ WHO MAY PUSH WHERE.  ⟦NEW 08/09 · Roy's explicit instruction⟧
#
# `RULES § 0.1 ב׳` is the most load-bearing rule in the constitution:
#   «⛔ אף סוכן ⛔ אינו דוחף ל-main — מלבד PROMOTER, פעמיים ביום, 5 0,12 * * * UTC.»
# 🔬 **And ⛔ nothing enforced it.** Measured 08/09: `git grep origin/main -- scripts/`
# returns **zero**. The rule was a sentence in a file, exactly like `npm run verify` was
# before הכרעה 100 — and this is the same move, on the same hook, for the same reason.
#
# ⚠️ The identity is the one the agent sets itself in STEP A of its own prompt
# (`./scripts/g config user.name`), which is the only agent identity that reaches git.
#
# 🔴 **AND ITS POSITION IS THE POINT: this runs BEFORE `SKIP_VERIFY`.** A broken `verify`
# is a reason to skip `verify`. It is ⛔ NEVER a reason to push to `main`.
#
# ⚠️ Honest about what this is: a gate against ACCIDENT and DRIFT, ⛔ not against an
# adversary — an agent can edit this file or pass `--no-verify`. ⛔ Exactly like the
# verify gate, and ⛔ that was never a reason not to build it.
# ═══════════════════════════════════════════════════════════════════════════════
WHOAMI="$(git config user.name 2>/dev/null || echo '')"
for ref in "${REFS[@]}"; do
  case "$ref" in
    refs/heads/main)
      if [ "$WHOAMI" != "promoter-agent" ]; then
        echo "⛔ הדחיפה ל-main נחסמה: הזהות היא '$WHOAMI', ⛔ ולא 'promoter-agent'."
        echo "⛔ RULES § 0.1 ב׳ — ⛔ אף סוכן ⛔ אינו דוחף ל-main מלבד PROMOTER."
        echo "⇒ QA ממזג ל-dev; PROMOTER לוקח משם. ⛔ אין מסלול אחר, ו-SKIP_VERIFY ⛔ אינו פותח אותו."
        exit 1
      fi
      ;;
    refs/heads/dev)
      case "$WHOAMI" in
        critic-agent|qa-agent|promoter-agent) ;;
        *)
          echo "⛔ הדחיפה ל-dev נחסמה: הזהות היא '$WHOAMI'."
          echo "⛔ RULES § 0.23 — ל-dev מגיעים רק דרך 'merge --ff-only' של QA."
          exit 1
          ;;
      esac
      ;;
  esac
done

if [ "${SKIP_VERIFY:-0}" = "1" ]; then
  echo "⚠️  SKIP_VERIFY=1 — הדחיפה עוברת ⛔ בלי verify."
  echo "⚠️  זו חריגה מוצהרת, ⛔ ולא נוהל. כתוב אותה בדוח הטיק, אחרת אין לה עקבות."
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "⛔ הדחיפה נחסמה: 'node_modules' חסר ⇒ 'npm run verify' ⛔ לא רץ, ⛔ ולא נכשל."
  echo "⇒ npm install && ./scripts/g push $REMOTE …"
  echo "⇒ או, אם verify עצמו שבור: SKIP_VERIFY=1 ./scripts/g push $REMOTE … (ודווח על כך)"
  exit 1
fi

DIRTY="$(git status --porcelain 2>/dev/null)"
if [ -n "$DIRTY" ]; then
  echo "⚠️  עץ העבודה ⛔ אינו נקי — verify רץ על העץ, ⛔ לא על הקומיט הנדחף:"
  echo "$DIRTY" | head -20
fi

# ═══════════════════════════════════════════════════════════════════════════════
# ⚡ THE FAST LANE — ⛔ RUN WHAT THE DIFF CAN ACTUALLY BREAK.  ⟦NEW 08/09⟧
#
# 🔬 **MEASURED, ⛔ not assumed.** Over 14 days: **161 of 516 loop commits (31%) touched
# ⛔ NOTHING but `plan/00-control.md`** — the "I am starting" lock commit. Since הכרעה 100
# every one of those runs a full `npm run verify`. At ~4 minutes that is **~11 hours of
# compute per fortnight spent announcing a start.**
#
# ⛔ **THIS IS ⛔ NOT A HOLE IN THE GATE, AND THE DISTINCTION IS THE WHOLE DESIGN.**
# The promise — «a red `verify` ⛔ cannot leave a clone» — is kept in full. What changes is
# that a diff which ⛔ CANNOT break a check no longer waits for it. Measured in this clone:
#
#   diff confined to plan/** · docs/plan-*.md · docs/agents/**
#     CAN break →  check:motion 1s · check:text-floor 0s · check:rules 1s
#                  + vitest scripts/ lib/core/ 28s              ⇒ ~30 seconds
#                  …those three scripts read plan/, and 8 test files read plan/ or
#                  docs/agents/ (agent-prompts · loop-health · plan-hygiene ·
#                  measure-plan-tables · rules-citations · motion-gate ·
#                  text-floor-gate · gc-memory).
#     ⛔ CANNOT break →  typecheck · check:core · check:titles · build · check:mobile
#                  …⛔ no .ts changed, ⛔ no route changed, ⛔ no pixel changed.
#
# 🔴 **ONE path outside the set ⇒ the FULL run. ⛔ No exceptions, ⛔ no "mostly".**
# ⛔ **And ⛔ no diff we could not read ⇒ the FULL run.** Doubt resolves to slow, ⛔ never fast.
# ⚠️ The attestation says `verify(fast)`, ⛔ never `verify` — check 16 must ⛔ never tell a
# different story from what actually ran.
# ═══════════════════════════════════════════════════════════════════════════════
CHANGED="$(git diff --name-only "$REMOTE/$(git rev-parse --abbrev-ref HEAD)"...HEAD 2>/dev/null || true)"
[ -z "$CHANGED" ] && CHANGED="$(git diff --name-only HEAD~1..HEAD 2>/dev/null || true)"

REGISTER_ONLY=1
if [ -z "$CHANGED" ]; then
  REGISTER_ONLY=0                     # ⛔ ⛔ לא ידענו מה השתנה ⇒ מלא. ספק ⇒ איטי.
else
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      plan/*|docs/plan-*.md|docs/agents/*) ;;
      *) REGISTER_ONLY=0; break ;;
    esac
  done <<< "$CHANGED"
fi

if [ "$REGISTER_ONLY" = "1" ]; then
  VERIFY_LABEL="verify(fast)"
  echo "⚡ pre-push — הדיף מוגבל ל-plan/ · docs/plan-* · docs/agents/ ⇒ מסלול מהיר."
  echo "⛔ ⛔ זה ⛔ אינו דילוג: רץ כל מה שדיף כזה יכול לשבור, ו⛔ לא רץ מה שהוא ⛔ אינו יכול."
  if ! { npm run check:motion && npm run check:text-floor && npm run check:rules && npx vitest run scripts/ lib/core/; }; then
    echo ""
    echo "⛔ הדחיפה נחסמה: המסלול המהיר יצא בקוד ⛔ לא-אפס."
    echo "⛔ ⛔ אל תעקוף. תקן, או הפוך את הכישלון לממצא ב-plan/60-findings.md."
    exit 1
  fi
else
  VERIFY_LABEL="verify"
  echo "🔒 pre-push — מריץ npm run verify לפני הדחיפה ל-$REMOTE …"
  if ! npm run verify; then
    echo ""
    echo "⛔ הדחיפה נחסמה: 'npm run verify' יצא בקוד ⛔ לא-אפס."
    echo "⛔ ⛔ אל תעקוף. תקן, או קרא את הכישלון והפוך אותו לממצא ב-plan/60-findings.md."
    echo "⇒ מוצא חירום מוצהר בלבד: SKIP_VERIFY=1 ./scripts/g push $REMOTE …"
    exit 1
  fi
fi

# ⛔ ⟦NEW 07/09⟧ SYNC BEFORE APPENDING — ⛔ or the push is rejected non-fast-forward.
#
# 🔬 Measured: a notes commit's parent is the previous notes commit, so appending to a
# LOCAL ref that has drifted behind the PUBLISHED one produces a history that ⛔ does
# not contain it ⇒ `! [rejected] (non-fast-forward)`, and the attestation never lands.
# That is ⛔ exactly what happened on 5c4586f: `loop:health` check 16 force-fetched the
# stale `refs/notes/verify` into the same ref this hook writes to, rolling it back.
# ⇒ take the published ref as the base **before** appending. The mirror is preferred
# because in CCR it is the only one that can be published at all.
git fetch -q "$REMOTE" "+refs/heads/notes-verify:refs/notes/verify" >/dev/null 2>&1 \
  || git fetch -q "$REMOTE" "+refs/notes/verify:refs/notes/verify" >/dev/null 2>&1 \
  || true

STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
NOTED=0
for sha in "${TIPS[@]}"; do
  # ⛔ `$VERIFY_LABEL` is `verify` or `verify(fast)` — ⛔ never a label for a run that did
  # ⛔ not happen. Check 16 reads this note; a note that overstates what ran would make the
  # ⛔ attestation a claim instead of evidence, which is the one thing it exists against.
  if git notes --ref=verify add -f -m "$VERIFY_LABEL: exit 0 · $STAMP · $(git rev-parse --short "$sha")" "$sha" >/dev/null 2>&1; then
    NOTED=$((NOTED + 1))
  else
    # ⛔ ⟦07/09⟧ This used to be `|| true` — a swallow, ⛔ not a decision. A note that
    # was never written looks identical to a note that failed to push, and check 16
    # reports the same «⛔ לא נמדד» for both ⇒ ⛔ the two causes were indistinguishable
    # for as long as the swallow existed. ⛔ Still ⛔ never fatal: an attestation is
    # evidence, ⛔ and evidence that fails to write ⛔ must not cost the branch its commits.
    echo "⚠️  git notes add ⛔ נכשל על $(git rev-parse --short "$sha") — ⛔ אין ראיה לכתוב, ⛔ ולא רק לדחוף."
  fi
done

# ⛔ Best-effort, ⛔ never fatal: a missing attestation is a warning in check 16,
# ⛔ and a failed notes push must ⛔ never cost the branch its real commits.
PUSH=git
[ -x ./scripts/g ] && PUSH=./scripts/g

# ⛔ ⟦NEW 07/09⟧ TWO REF NAMES FOR ONE OBJECT — and it is ⛔ not belt-and-braces.
#
# 🔬 Measured live in Claude Code Remote, 07/09, three consecutive attempts, same repo:
#     git push origin refs/notes/verify                  ⇒ send-pack disconnect, remote UNCHANGED
#     git push origin refs/notes/verify:refs/heads/notes-verify ⇒ exit 0, first try
#     git push origin <branch>                           ⇒ exit 0
# ⇒ **`refs/heads/*` is the only ref namespace that survives that runtime.** The
# object pushed is the ⛔ SAME notes commit — ⛔ only the ref name differs, so ⛔ no
# second source of truth and ⛔ nothing to keep in sync by hand.
#
# ⛔ Both are attempted, ⛔ and the warning fires only when BOTH fail — a run that
# publishes the attestation under either name is a run whose evidence is readable.
NOTES_OK=0
VERIFY_HOOK_INTERNAL=1 "$PUSH" push -q --no-verify "$REMOTE" refs/notes/verify >/dev/null 2>&1 && NOTES_OK=1
VERIFY_HOOK_INTERNAL=1 "$PUSH" push -q --no-verify "$REMOTE" refs/notes/verify:refs/heads/notes-verify >/dev/null 2>&1 && NOTES_OK=1
[ "$NOTES_OK" = "1" ] || \
  echo "⚠️  ההערה נכתבה מקומית אך ⛔ לא נדחפה בשם אף אחד משני ה-refs — בדיקה 16 תדווח «⛔ לא נמדד»."

echo "✅ verify ירוק · הדחיפה ממשיכה · חותמת: $STAMP"
exit 0

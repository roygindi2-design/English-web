{
  "name": "english-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:core": "node scripts/check-core-purity.mjs",
    "check:mobile": "node scripts/verify-mobile.mjs",
    "walk:journey": "node scripts/verify-mobile.mjs --journeys-only",
    "walk:screens": "node scripts/walk-screens.mjs",
    "check:palette": "node scripts/validate_palette.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:text-floor": "node scripts/check-text-floor.mjs",
    "check:rules": "node scripts/check-rules-citations.mjs",
    "check:titles": "node scripts/check-page-titles.mjs",
    "cycle-id": "node scripts/next-cycle-id.mjs",
    "diff:render": "node scripts/diff-render.mjs",
    "gc:memory": "node scripts/gc-memory.mjs",
    "archive": "node scripts/archive-registers.mjs && node scripts/archive-departments.mjs",
    "preview:stop": "node scripts/stop-preview.mjs",
    "verify:attested": "node scripts/verify-attested.mjs",
    "archive:stale": "node scripts/archive-stale.mjs",
    "archive:arch": "node scripts/archive-architecture.mjs",
    "measure:coverage": "node scripts/measure-coverage.mjs",
    "measure:sense": "node scripts/measure-sense-accuracy.mjs",
    "measure:headroom": "node scripts/measure-level-headroom.mjs",
    "measure:gate": "node scripts/measure-gate.mjs",
    "measure:mix": "node scripts/measure-mix.mjs",
    "measure:continuations": "node scripts/measure-continuations.mjs",
    "measure:amirnet-gate": "node scripts/measure-amirnet-gate.mjs",
    "measure:amirnet-coverage": "node scripts/measure-amirnet-coverage.mjs",
    "measure:plan": "node scripts/measure-plan-tables.mjs",
    "build:ingest": "node scripts/build-ingest-sql.mjs",
    "build:levels": "node scripts/build-word-levels-sql.mjs",
    "build:preview": "node scripts/build-preview-cards.mjs",
    "build:stories": "node scripts/build-stories-sql.mjs",
    "build:questions": "node scripts/build-story-questions-sql.mjs",
    "build:surfaces": "node scripts/build-surfaces.mjs",
    "build:amirnet-items": "node scripts/build-amirnet-items.mjs",
    "build:amirnet-vocab": "node scripts/build-amirnet-vocab.mjs",
    "fetch:wordnet": "node scripts/fetch-wordnet.mjs",
    "verify": "npm run typecheck && npm run check:core && npm run check:motion && npm run check:text-floor && npm run check:rules && npm run check:titles && npm test && npm run build && npm run check:mobile",
    "verify:fast": "npm run typecheck && npm run check:core && npm run check:motion && npm run check:text-floor && npm run check:rules && npm run check:titles && npm test",
    "check:plan": "node scripts/check-plan-shape.mjs",
    "loop:health": "node scripts/loop-health.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "generate-map": "node scripts/generate-map.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^16.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "madge": "8.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
